# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada para montar os links enviados por e-mail
# (confirmação de cadastro e recuperação de senha). Em produção, aponte
# para o domínio real (ex.: https://app.caixa360.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
